<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
	  
    <Company>regularentropy</Company>
    <!-- display name: the window title, the About page and the exe's Product property read this.
         AssemblyName stays Hakata, so the data dir, the profiles and the namespace don't move. -->
    <Product>Hakata</Product>
    <AssemblyName>hakata</AssemblyName>
    <!-- the About page and the update check read this number, so a release bumps one value -->
    <Version>1.0.0</Version>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
	  
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <PublishTrimmed>false</PublishTrimmed>
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Hakata.Tests" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/*.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.6" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Material.Icons.Avalonia" Version="3.0.2" />
    <!-- release notes in the update window render as markdown -->
    <PackageReference Include="Markdown.Avalonia.Tight" Version="12.0.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageReference Include="NAudio" Version="3.3.0" />
    <!-- the device backends the NAudio meta package leaves to Windows: ALSA on Linux, libsndfile for
         decoding what Windows decodes through Media Foundation/ACM (mp3, flac, ogg, opus) -->
    <PackageReference Include="NAudio.Alsa" Version="3.3.0" />
    <PackageReference Include="NAudio.SoundFile" Version="3.3.0" />
    <!-- DPAPI for the API keys at rest in settings.json (KeyProtector) -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.14" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>
</Project>
