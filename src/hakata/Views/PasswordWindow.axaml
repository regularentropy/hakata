<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Hakata.Views.PasswordWindow"
        Title="History password"
        Classes="dialog">
  <Border Classes="card page dialog">
    <StackPanel Classes="dialog">
      <TextBlock x:Name="TitleText" Text="Unlock history" Classes="title"/>
      <TextBlock x:Name="HintText" Classes="small" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
      <TextBox x:Name="PasswordBox" PasswordChar="●" PlaceholderText="Password"
               AutomationProperties.Name="Password"/>
      <TextBox x:Name="ConfirmBox" PasswordChar="●" PlaceholderText="Repeat password"
               AutomationProperties.Name="Repeat the password"/>
      <TextBlock x:Name="ErrorText" Classes="small" Foreground="{DynamicResource Danger}"
                 TextWrapping="Wrap" IsVisible="False"/>
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button x:Name="CancelButton" Content="Cancel" Click="OnCancel" Classes="dialogAction" IsCancel="True"/>
        <Button x:Name="OkButton" Content="Unlock" Click="OnOk" Classes="dialogPrimary" IsDefault="True"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
