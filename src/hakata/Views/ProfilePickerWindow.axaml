<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Hakata.Views"
        x:Class="Hakata.Views.ProfilePickerWindow"
        x:CompileBindings="True"
        Title="Choose profile"
        Classes="dialog">
  <Border Classes="card page dialog">
    <StackPanel Classes="dialog">
      <TextBlock x:Name="TitleText" Text="Choose profile" Classes="title"/>
      <ListBox x:Name="List" MinHeight="120" AutomationProperties.Name="Profiles"
               DoubleTapped="OnRowDoubleTapped">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="views:ProfilePickerWindow+Row">
            <StackPanel Spacing="0">
              <ToolTip.Tip>
                <TextBlock Text="{Binding Dir}" TextWrapping="NoWrap"/>
              </ToolTip.Tip>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding Name}"/>
                <TextBlock Text="running" Classes="small" Foreground="{DynamicResource Accent}" IsVisible="{Binding Running}"/>
              </StackPanel>
              <TextBlock Text="{Binding Dir}" Classes="small" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock x:Name="HintText" Classes="small" Foreground="{DynamicResource TextMuted}"
                 TextWrapping="Wrap" Text="Open loads the selected profile here"/>
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <!-- manager mode only: at the startup picker nothing is running yet, so there is nothing to run beside -->
        <Button x:Name="NewInstanceButton" Content="Open in new instance" Click="OnOpenNew" Classes="dialogAction" IsVisible="False"/>
        <Button x:Name="CancelButton" Content="Cancel" Click="OnCancel" Classes="dialogAction" IsCancel="True"/>
        <Button x:Name="OpenButton" Content="Open" Click="OnOpen" Classes="dialogPrimary" IsDefault="True"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
